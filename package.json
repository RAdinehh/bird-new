{
  "name": "poultry-manager",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile ./node_modules/.cache/.tsc-incremental",
    "test:ci": "vitest run --coverage",
    "ci": "npm run typecheck && npm run test:ci",
    "check:catch": "grep -rn 'catch (e) {}' src/mod --include='*.ts*' || true"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@hookform/resolvers": "^3.9.1",
    "date-fns-jalali": "^3.6.0-0",
    "decimal.js": "^10.6.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.55.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-router-dom": "^6.28.0",
    "ts-morph": "^28.0.0",
    "uuid": "^11.0.3",
    "zod": "^3.25.76",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.12.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
